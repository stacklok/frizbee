{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Batch non-major Go module updates into a single PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go deps",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Batch non-major GitHub Actions updates (incl. digest re-pins) into a single PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
